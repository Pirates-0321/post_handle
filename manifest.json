{
  "manifest_version": 3,
  "name": "163邮箱重点邮件助手",
  "version": "0.5.0",
  "description": "监控 163 邮箱重点关注发件人的新邮件，收到时弹出常驻桌面通知提醒。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://*.163.com/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.163.com/*"
      ],
      "js": [
        "src/shared/storage.js",
        "src/content/selectors.js",
        "src/content/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html"
}
